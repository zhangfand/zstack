{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/router/bootstrap.sh" },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/agents-md.sh session" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/agents-md.sh pre-tool" }
        ]
      }
    ]
  }
}
